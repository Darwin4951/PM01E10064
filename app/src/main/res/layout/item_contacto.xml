<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_input" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/fotoContacto" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_camera" android:contentDescription="Ver imagen" android:clickable="true" android:focusable="true" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/nombreContacto" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/contact_text" />
            <TextView android:id="@+id/paisContacto" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/contact_text" />
            <TextView android:id="@+id/telefonoContacto" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/contact_green" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/llamarContacto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Llamar" android:textAllCaps="false" android:layout_marginHorizontal="2dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/editarContacto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Editar" android:textAllCaps="false" android:layout_marginHorizontal="2dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/eliminarContacto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Eliminar" android:textAllCaps="false" android:layout_marginHorizontal="2dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/compartirContacto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Compartir" android:textAllCaps="false" android:layout_marginHorizontal="2dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/verImagenContacto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Ver imagen" android:textAllCaps="false" android:layout_marginHorizontal="2dp" />
    </LinearLayout>
</LinearLayout>
