<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listaRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/contact_green">
    <com.google.android.material.appbar.MaterialToolbar android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="Contactos" app:titleTextColor="@color/contact_white" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@color/contact_light_green">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAgregar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="Agregar contacto" android:textAllCaps="false" />
        <TextView android:id="@+id/listaVacia" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="24dp" android:text="No hay contactos registrados" android:textColor="@color/contact_text" android:textSize="18sp" />
        <ListView android:id="@+id/listaContactos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:padding="12dp" android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
