<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/contact_green">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/contact_green" app:title="@string/nuevo_contacto" app:titleTextColor="@color/contact_white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@color/contact_background" android:fillViewport="true"
        android:padding="24dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivImagen"
                android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/contact_light_green" android:background="@drawable/bg_input"
                android:src="@drawable/ic_camera" android:scaleType="center" android:clickable="true" android:focusable="true"
                android:contentDescription="@string/agregar_imagen" app:shapeAppearanceOverlay="@style/AvatarShape" />
            <TextView android:id="@+id/tvAgregarImagen" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="center_horizontal" android:gravity="center" android:paddingHorizontal="16dp"
                android:text="@string/agregar_imagen" android:textColor="@color/contact_green" android:textStyle="bold"
                android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
            <TextView style="@style/ContactLabel" android:text="@string/pais" android:labelFor="@id/spPais" />
            <Spinner android:id="@+id/spPais" android:layout_width="match_parent" android:layout_height="54dp"
                android:background="@drawable/bg_input" android:paddingHorizontal="12dp" android:spinnerMode="dropdown" android:contentDescription="@string/pais" />
            <TextView style="@style/ContactLabel" android:text="@string/nombre" android:labelFor="@id/etNombre" />
            <EditText android:id="@+id/etNombre" style="@style/ContactInput" android:hint="@string/nombre_hint"
                android:inputType="textPersonName|textCapWords" android:maxLines="1" android:imeOptions="actionNext" />
            <TextView style="@style/ContactLabel" android:text="@string/telefono" android:labelFor="@id/etTelefono" />
            <EditText android:id="@+id/etTelefono" style="@style/ContactInput" android:hint="@string/telefono_hint"
                android:inputType="phone" android:maxLines="1" android:imeOptions="actionNext" />
            <TextView style="@style/ContactLabel" android:text="@string/nota" android:labelFor="@id/etNota" />
            <EditText android:id="@+id/etNota" style="@style/ContactInput" android:hint="@string/nota_hint"
                android:inputType="textMultiLine|textCapSentences" android:lines="3" android:gravity="top|start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardar"
                android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="24dp"
                android:text="@string/guardar_contacto" android:textColor="@color/contact_white" android:textAllCaps="false"
                app:backgroundTint="@color/contact_green" app:cornerRadius="12dp" app:icon="@drawable/ic_save"
                app:iconTint="@color/contact_white" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnVerContactos"
                android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp"
                android:text="@string/ver_contactos" android:textColor="@color/contact_green" android:textAllCaps="false"
                app:backgroundTint="@color/contact_white" app:strokeColor="@color/contact_green" app:strokeWidth="1dp"
                app:cornerRadius="12dp" app:icon="@drawable/ic_list" app:iconTint="@color/contact_green" app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
